<!-- One element of the 2x2 FR4 array in ..\2_4_patch_arr, alone on its 62 x 62 mm cell (the array pitch). -->
<!-- Inset-fed patch: resonant side patch_l along y (polarised along y), width patch_w along x, fed on its -y edge. -->
<!-- Feed: 50 Ohm microstrip from the board edge into an inset of depth inset_l, with a slot gap on each side. -->
<!-- Units: length [mm], frequency [GHz], resistance [Ohm]. Metals are flat sheets (z start = z stop). -->

<model>

    <!-- Board: substrate width (x), length (y) and height (z). -->
    <parameter>
        <symbol> sub_w </symbol>
        <value> 62 </value>
    </parameter>

    <parameter>
        <symbol> sub_l </symbol>
        <value> 62 </value>
    </parameter>

    <parameter>
        <symbol> sub_h </symbol>
        <value> 1.6 </value>
    </parameter>

    <!-- Patch: patch_l sets the resonance, inset_l the match. -->
    <parameter>
        <symbol> patch_w </symbol>
        <value> 38 </value>
    </parameter>

    <parameter>
        <symbol> patch_l </symbol>
        <value> 29.4 </value>
    </parameter>

    <parameter>
        <symbol> inset_l </symbol>
        <value> 6.0 </value>
    </parameter>

    <parameter>
        <symbol> slot_gap </symbol>
        <value> 1.0 </value>
    </parameter>

    <!-- Feed: 50 Ohm line width on this substrate. -->
    <parameter>
        <symbol> feed_w </symbol>
        <value> 3.11 </value>
    </parameter>

    <box>
        <name> sub </name>
        <material> FR4 </material>
        <x> [-sub_w/2, sub_w/2] </x>
        <y> [-sub_l/2, sub_l/2] </y>
        <z> [0, sub_h] </z>
    </box>

    <box>
        <name> gnd </name>
        <material> copper </material>
        <x> [-sub_w/2, sub_w/2] </x>
        <y> [-sub_l/2, sub_l/2] </y>
        <z> 0 </z>
    </box>

    <!-- Patch body above the inset: from the inset bottom to the +y edge. -->
    <box>
        <name> patch_main </name>
        <material> copper </material>
        <x> [-patch_w/2, patch_w/2] </x>
        <y> [-patch_l/2 + inset_l, patch_l/2] </y>
        <z> sub_h </z>
    </box>

    <!-- Patch parts left and right of the inset, outside the slots. -->
    <box>
        <name> patch_left </name>
        <material> copper </material>
        <x> [-patch_w/2, -(feed_w/2 + slot_gap)] </x>
        <y> [-patch_l/2, -patch_l/2 + inset_l] </y>
        <z> sub_h </z>
    </box>

    <box>
        <name> patch_right </name>
        <material> copper </material>
        <x> [feed_w/2 + slot_gap, patch_w/2] </x>
        <y> [-patch_l/2, -patch_l/2 + inset_l] </y>
        <z> sub_h </z>
    </box>

    <!-- 50 Ohm line from the board edge into the inset, touching the patch body. -->
    <box>
        <name> feed </name>
        <material> copper </material>
        <x> [-feed_w/2, feed_w/2] </x>
        <y> [-sub_l/2, -patch_l/2 + inset_l] </y>
        <z> sub_h </z>
    </box>

    <!-- Edge port: from the ground up to the line, like an edge launch SMA. -->
    <port>
        <name> p1 </name>
        <resistance> 50 </resistance>
        <direction> z </direction>
        <x> [-feed_w/2, feed_w/2] </x>
        <y> -sub_l/2 </y>
        <z> [0, sub_h] </z>
    </port>

    <!-- 10 MHz steps, so 2.4 GHz is a sweep point. -->
    <frequency>
        <start> 2.0 </start>
        <stop> 2.8 </stop>
        <points> 81 </points>
    </frequency>

    <mesh>
        <cells_per_wavelength> 20 </cells_per_wavelength>
        <air_margin> 0.25 </air_margin>
    </mesh>

    <monitors>

        <s_params>
            <port> p1 </port>
        </s_params>

        <far_field>
            <name> ff_2_4 </name>
            <port> p1 </port>
            <frequency> 2.4 </frequency>
            <resolution> 2 </resolution>
        </far_field>

        <!-- Plane 20 mm above the patch, covering the whole board. -->
        <near_field>
            <name> nf_2_4 </name>
            <port> p1 </port>
            <frequency> 2.4 </frequency>
            <x> [-40, 40] </x>
            <y> [-40, 40] </y>
            <z> sub_h + 20 </z>
            <resolution> 2 </resolution>
        </near_field>

    </monitors>

</model>
